# Copied to .env by `make dev`. Fill in what you need; everything else has a working default.

# ---- LLM: any OpenAI-compatible provider -------------------------------------------------------
# Routine messages (price, stock, quotes, FAQ, greetings, hand-off) are answered by the locally
# trained models at zero cost; the LLM is only called for everything else.

# Option A (default): Google Gemini - get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODEL=gemini-3.8-flash          # live customer replies + campaign drafts
# LLM_MODEL_LITE=gemini-3.5-flash-lite # follow-ups, reorders, first touch, insights (cheapest)

# Option A2: OpenRouter FREE tier - open models, no GPU, $0. Key at https://openrouter.ai/keys
#   Limits: 50 requests/day (1,000/day after buying $10 credits); free providers may train on prompts,
#   so use it for pilots/demo data, not real customer data. Uses qwen/qwen3.8-27b:free, falling back to
#   gemma-4-26b/31b and nemotron-3-super/ultra (all :free) when a free pool is busy. Paid models are refused.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# LLM_FALLBACK_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-26b-a4b-it:free   # optional override

# Option B: open-source models on your own machine, free - install Ollama, then `ollama pull qwen3:8b`
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# LLM_MODEL_LITE=qwen3:4b

# Option B2: Sarvam-30B, self-hosted, best for Tamil/Hindi/other Indian-language customers
#   on the GPU box:  python -m sglang.launch_server --model-path sarvamai/sarvam-30b --port 8000
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://gpu-box:8000/v1
# LLM_MODEL=sarvamai/sarvam-30b
# LLM_MODEL_LITE=sarvamai/sarvam-30b

# Option C: self-hosted Qwen3.6-35B-A3B (evaluated, not chosen for now) or any OpenAI-compatible server
#   on the GPU box:  vllm serve Qwen/Qwen3.6-35B-A3B --enable-auto-tool-choice --tool-call-parser qwen3_coder
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://gpu-box:8000/v1
# LLM_MODEL=Qwen/Qwen3.6-35B-A3B
# LLM_MODEL_LITE=Qwen/Qwen3.6-35B-A3B   # one vLLM server = one model; 3B active is already cheap
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}   # fast, no <think> in replies

# Cost tracking on the dashboard (USD per 1M tokens; 0 = don't estimate). Check your provider's price page.
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0
# `make models` lists what your provider offers.

# ---- Storage -----------------------------------------------------------------------------------
# SQLite file by default; for Postgres run `uv add "psycopg[binary]"` then:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/sales
DATABASE_URL=sqlite:///sales.db
MODEL_DIR=models

# Creating tenants via POST /v1/tenants (make dev defaults this to dev-admin)
ADMIN_KEY=dev-admin

# ---- Channels ----------------------------------------------------------------------------------
# WhatsApp Cloud API. Phone number ID + token are entered in the app (Settings); these two are for replies (webhook)
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_API_VERSION=v23.0

# Email: fill all five and restart; with channel "auto" email is used for customers WhatsApp can't reach
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
